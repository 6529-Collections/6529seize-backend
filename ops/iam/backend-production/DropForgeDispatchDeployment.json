{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:987989283142:drop-forge-launch",
        "arn:aws:sqs:us-east-1:987989283142:drop-forge-launch-dlq",
        "arn:aws:sqs:us-east-1:987989283142:memes-distribution",
        "arn:aws:sqs:us-east-1:987989283142:memes-distribution-dlq"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateScheduleGroup",
        "scheduler:DeleteScheduleGroup",
        "scheduler:GetScheduleGroup",
        "scheduler:ListTagsForResource",
        "scheduler:TagResource",
        "scheduler:UntagResource"
      ],
      "Resource": [
        "arn:aws:scheduler:us-east-1:987989283142:schedule-group/drop-forge-prod"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::987989283142:role/drop-forge-prod-launch",
        "arn:aws:iam::987989283142:role/drop-forge-prod-distribution"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole"
      ],
      "Resource": [
        "arn:aws:iam::987989283142:role/drop-forge-prod-launch",
        "arn:aws:iam::987989283142:role/drop-forge-prod-distribution"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnEquals": {
          "lambda:FunctionArn": [
            "arn:aws:lambda:us-east-1:987989283142:function:dropForgeLaunchHandler",
            "arn:aws:lambda:us-east-1:987989283142:function:memesDistributionHandler"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:987989283142:event-source-mapping:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnEquals": {
          "lambda:FunctionArn": [
            "arn:aws:lambda:us-east-1:987989283142:function:dropForgeLaunchHandler",
            "arn:aws:lambda:us-east-1:987989283142:function:memesDistributionHandler"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:987989283142:event-source-mapping:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
