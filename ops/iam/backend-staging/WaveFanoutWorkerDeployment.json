      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        },
        "ArnEquals": {
          "lambda:FunctionArn": [
            "arn:aws:lambda:eu-west-1:987989283142:function:waveFanoutWorker"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:eu-west-1:987989283142:event-source-mapping:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
