{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "resolveJsonModule": true, "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node"], "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
