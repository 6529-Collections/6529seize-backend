{
  "name": "6529backend",
  "version": "1.0.0",
  "main": "backend.js",
  "scripts": {
    "preinstall": "node scripts/require-6529-command.cjs",
    "backend:local": "node scripts/require-6529-command.cjs && NODE_ENV=local nodemon src/backend.ts",
    "api:local": "node scripts/require-6529-command.cjs && NODE_ENV=local node src/api-serverless/dist/index.js",
    "backend:dev": "node scripts/require-6529-command.cjs && NODE_ENV=development node build/backend.js",
    "api:dev": "node scripts/require-6529-command.cjs && NODE_ENV=development node src/api-serverless/dist/index.js",
    "backend:prod": "node scripts/require-6529-command.cjs && NODE_ENV=production node build/backend.js",
    "db:staging:resume": "node scripts/require-6529-command.cjs && bash scripts/sync-staging-db-local.sh --yes",
    "db:staging:fresh": "node scripts/require-6529-command.cjs && bash scripts/sync-staging-db-local.sh --fresh --yes",
    "package-manager:check": "node scripts/require-6529-command.cjs && node scripts/check-package-manager.mjs",
    "package-manager:fix": "node scripts/require-6529-command.cjs && node scripts/check-package-manager.mjs --fix",
    "generate:deploy-config": "node scripts/require-6529-command.cjs && node scripts/generate-deploy-config.mjs",
    "prebuild": "node scripts/require-6529-command.cjs && npm run generate:deploy-config",
    "build": "node scripts/require-6529-command.cjs && rimraf ./build && jest && NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.json",
    "postbuild": "node scripts/require-6529-command.cjs && cp src/teamLoop/team.csv build/teamLoop && cp src/rememesLoop/rememes.csv build/rememesLoop",
    "migrate:new": "node scripts/require-6529-command.cjs && node node_modules/db-migrate/bin/db-migrate -e local create",
    "migrate-local:up": "node scripts/require-6529-command.cjs && node node_modules/db-migrate/bin/db-migrate -e local up",
    "migrate-local:down": "node scripts/require-6529-command.cjs && node node_modules/db-migrate/bin/db-migrate -e local down",
    "migrate:up": "node scripts/require-6529-command.cjs && node node_modules/db-migrate/bin/db-migrate -e main up",
    "migrate:down": "node scripts/require-6529-command.cjs && node node_modules/db-migrate/bin/db-migrate -e main down",
    "tsc": "node scripts/require-6529-command.cjs && ./node_modules/typescript/bin/tsc",
    "pretest": "node scripts/require-6529-command.cjs && npm run generate:deploy-config",
    "test": "node scripts/require-6529-command.cjs && jest",
    "drop-media:backfill:dry-run": "node scripts/require-6529-command.cjs && ts-node -r tsconfig-paths/register src/dropMediaSanitizer/backfill-existing-drop-media.ts",
    "drop-media:backfill:live": "node scripts/require-6529-command.cjs && ts-node -r tsconfig-paths/register src/dropMediaSanitizer/backfill-existing-drop-media.ts --live",
    "check": "node scripts/require-6529-command.cjs && npm run format && npm run lint && npm run build",
    "check:changed": "node scripts/require-6529-command.cjs && node scripts/check-changed.mjs",
    "ci:assert-source-clean": "node scripts/require-6529-command.cjs && node scripts/assert-pr-ci-source-clean.mjs",
    "format": "node scripts/require-6529-command.cjs && prettier --write \"src/**/*.ts\"",
    "format:check": "node scripts/require-6529-command.cjs && prettier --check \"src/**/*.ts\"",
    "prelint": "node scripts/require-6529-command.cjs && npm run generate:deploy-config",
    "lint": "node scripts/require-6529-command.cjs && NODE_OPTIONS=--max-old-space-size=8192 eslint \"src/**/*.ts\" --fix --max-warnings=0",
    "lint:check": "node scripts/require-6529-command.cjs && NODE_OPTIONS=--max-old-space-size=8192 eslint \"src/**/*.ts\" --max-warnings=0"
  },
