[
  {
    "name": "level-min-at-border",
    "dimension": "level",
    "description": "level_min stores a level number; level_raw 100 is exactly level 3's lower border, so level_min 3 passes and level_min 4 fails on both engines (spec \u00a74).",
    "identities": [
      {
        "id": "subject",
        "level_raw": 100
      }
    ],
    "subject": "subject",
    "groups": [
      {
        "id": "g-min-3",
        "level_min": 3
      },
      {
        "id": "g-min-4",
        "level_min": 4
      }
    ],
    "expected": {
      "eligible_group_ids": ["g-min-3"]
    }
  },
  {
    "name": "level-max-exact-border-agree",
    "dimension": "level",
    "description": "At the exact lower border of the level (level_raw 100 = border of level 3) both level_max encodings agree (spec \u00a74).",
    "identities": [
      {
        "id": "subject",
        "level_raw": 100
      }
    ],
    "subject": "subject",
    "groups": [
      {
        "id": "g-max-3",
        "level_max": 3
      }
    ],
    "expected": {
      "eligible_group_ids": ["g-max-3"]
    }
  },
  {
    "name": "level-max-inside-level",
