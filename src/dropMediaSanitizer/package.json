{
  "name": "dropmediasanitizer",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "preinstall": "node ../../scripts/require-6529-command.cjs",
    "prebuild": "node ../../scripts/require-6529-command.cjs && rm -rf dist && mkdir -p dist && rm -rf node_modules",
    "build": "node ../../scripts/require-6529-command.cjs && npm ci --arch=x64 --platform=linux && esbuild --external:sharp index.ts --bundle --sourcemap --platform=node --target=es2020 --outfile=dist/index.js",
    "postbuild": "node ../../scripts/require-6529-command.cjs && cp -r node_modules dist/ && cp package.json dist/ && cd dist && zip -rq index.zip index.js index.js.map node_modules package.json && rm -rf node_modules && rm package.json && cd ..",
    "sls-deploy:prod": "node ../../scripts/require-6529-command.cjs && node ../../node_modules/serverless/bin/serverless.js deploy --stage=prod --region=us-east-1",
    "sls-deploy:staging": "node ../../scripts/require-6529-command.cjs && node ../../node_modules/serverless/bin/serverless.js deploy --stage=staging --region=eu-west-1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.110"
  },
  "packageManager": "npm@10.9.8"
}
